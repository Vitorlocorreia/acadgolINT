NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Alternative for an existing project: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Fixed school location. Optional when the database has exactly one active unit.
SCHOOL_UNIT_ID=
# Optional. Configure a stable provider and rotate any previously exposed credentials.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=sport-escolinha
# Dedicated backend worker token; register its SHA-256 hash in private.whatsapp_workers.
# Never prefix this variable with NEXT_PUBLIC_ or share it with browsers.
WHATSAPP_WORKER_TOKEN=
# Never add a Supabase service role key to this app. It stays in Supabase Edge Functions.
